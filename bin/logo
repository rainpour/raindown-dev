#!/usr/bin/env ruby
# frozen_string_literal: true

# Writes "public/assets/raindown.svg", the home page's rain cloud as a logo, from the same seeded RainCloud, so the
# two match block for block, and with --png "public/assets/raindown.png" too, with a transparent background. Run it
# again after changing the cloud.
#   bin/logo
#   bin/logo --png

require 'zlib'

require_relative '../app/home/rain_cloud'

CELL_WIDTH = 6
CELL_HEIGHT = 10
HALF_WIDTH = CELL_WIDTH / 2
HALF_HEIGHT = CELL_HEIGHT / 2
RAIN_BLUE = 'hsl(212 100% 70%)'
PNG_SCALE = 4

# Each character as the rectangles it fills in its cell, [x, y, width, height], and its opacity. Rain is drawn wider
# than a line of text, so it still shows when the logo is small.
SHAPES = {
  '█' => [[[0, 0, CELL_WIDTH, CELL_HEIGHT]], 1],
  '▓' => [[[0, 0, CELL_WIDTH, CELL_HEIGHT]], 0.72],
  '▀' => [[[0, 0, CELL_WIDTH, HALF_HEIGHT]], 1],
  '▄' => [[[0, HALF_HEIGHT, CELL_WIDTH, HALF_HEIGHT]], 1],
  '▌' => [[[0, 0, HALF_WIDTH, CELL_HEIGHT]], 1],
  '▐' => [[[HALF_WIDTH, 0, HALF_WIDTH, CELL_HEIGHT]], 1],
  '▚' => [[[0, 0, HALF_WIDTH, HALF_HEIGHT], [HALF_WIDTH, HALF_HEIGHT, HALF_WIDTH, HALF_HEIGHT]], 1],
  '▞' => [[[HALF_WIDTH, 0, HALF_WIDTH, HALF_HEIGHT], [0, HALF_HEIGHT, HALF_WIDTH, HALF_HEIGHT]], 1],
  '│' => [[[2, 0, 2, CELL_HEIGHT]], 1],
  '╎' => [[[2, 0, 2, 4], [2, 5.5, 2, 4]], 1],
  '┊' => [[[2, 0.5, 2, 1.5], [2, 3, 2, 1.5], [2, 5.5, 2, 1.5], [2, 8, 2, 1.5]], 1],
  "'" => [[[2, 0, 2, 3.5]], 1],
  ',' => [[[2, 6, 2, 3.5]], 1]
}.freeze

# A rectangle of the logo, in its cell's place.
Rect = Data.define(:x, :y, :width, :height, :fill, :opacity) do
  def right = x + width
  def bottom = y + height

  def svg(left)
    opacity = %( opacity="#{self.opacity}") if self.opacity < 1
    %(<rect x="#{(x - left).round(1)}" y="#{y.round(1)}" width="#{width}" height="#{height}" fill="#{fill}"#{opacity}/>)
  end
end

# An image of red, green, blue and alpha bytes, with nothing behind its rectangles, written as a PNG.
class PngImage
  SIGNATURE = "\x89PNG\r\n\x1A\n".b
  RGBA = 6

  def initialize(width:, height:)
    @width = (width * PNG_SCALE).ceil
    @height = (height * PNG_SCALE).ceil
    @pixels = Array.new(@width * @height * 4, 0)
  end

  def draw(rect, left)
    columns = pixels_between(rect.x - left, rect.right - left)
    rows = pixels_between(rect.y, rect.bottom)
    color = rect.fill.delete('#').scan(/../).map { it.to_i(16) }

    rows.to_a.product(columns.to_a) { |row, column| blend(((row * @width) + column) * 4, color, rect.opacity) }
  end

  def write(path)
    header = [@width, @height, 8, RGBA, 0, 0, 0].pack('NNC5')
    lines = (0...@height).map { |row| "\0".b + @pixels[row * @width * 4, @width * 4].pack('C*') }
    File.binwrite(path, SIGNATURE + chunk('IHDR', header) + chunk('IDAT', Zlib.deflate(lines.join, 9)) + chunk('IEND', ''))
  end

  private

  def pixels_between(start, finish)
    (start * PNG_SCALE).round...(finish * PNG_SCALE).round
  end

  # The color over what's already at the pixel, as an SVG viewer draws one rectangle over another.
  def blend(index, color, opacity)
    below = @pixels[index + 3] / 255.0
    alpha = opacity + (below * (1 - opacity))
    color.each_with_index do |channel, offset|
      @pixels[index + offset] = (((channel * opacity) + (@pixels[index + offset] * below * (1 - opacity))) / alpha).round
    end
    @pixels[index + 3] = (alpha * 255).round
  end

  def chunk(type, data)
    [data.bytesize].pack('N') + type + data + [Zlib.crc32(type + data)].pack('N')
  end
end

# An hsl() colour as hex, which every SVG viewer reads.
def hex_color(hsl)
  hue, saturation, lightness = hsl.scan(/[\d.]+/).map(&:to_f).zip([1, 100, 100]).map { _1 / _2 }
  chroma = saturation * [lightness, 1 - lightness].min
  "##{[0, 8, 4].map { channel(it, hue, lightness, chroma).to_s(16).rjust(2, '0') }.join}"
end

# Red, green or blue, by its offset round the colour wheel, from 0 to 255.
def channel(offset, hue, lightness, chroma)
  k = (offset + (hue / 30)) % 12
  ((lightness - (chroma * [[k - 3, 9 - k, 1].min, -1].max)) * 255).round
end

def row_rects(row, top)
  fade = row.style&.[](/--opacity: ([\d.]+)/, 1)&.to_f || 1

  row.cells.each_with_index.flat_map do |(char, color), column|
    shapes, opacity = SHAPES[char]
    next [] unless shapes

    shapes.map do |x, y, width, height|
      Rect.new(x: (column * CELL_WIDTH) + x, y: top + y, width:, height:, fill: hex_color(color || RAIN_BLUE),
               opacity: (opacity * fade).round(2))
    end
  end
end

rects = RainCloud.new.rows.each_with_index.flat_map { |row, index| row_rects(row, index * CELL_HEIGHT) }
left = rects.map(&:x).min
width = rects.map(&:right).max - left
height = rects.map(&:bottom).max

path = File.expand_path('../public/assets/raindown.svg', __dir__)
File.write(path, <<~SVG)
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 #{width} #{height}" role="img"><title>Raindown</title>#{rects.map { it.svg(left) }.join}</svg>
SVG
puts "Wrote #{path}"

if ARGV.include?('--png')
  png = PngImage.new(width:, height:)
  rects.each { png.draw(it, left) }
  path = File.expand_path('../public/assets/raindown.png', __dir__)
  png.write(path)
  puts "Wrote #{path}"
end
